# Required to run locally. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-api-key-here

# Optional. The agent model. Defaults to claude-sonnet-5.
# Set to claude-opus-5 for more headroom at ~2.5x the cost.
MODEL=claude-sonnet-5

# Optional. Per-question spend ceiling, in USD. Defaults to 0.50.
# A question normally costs $0.02-0.06; this only stops a runaway loop.
MAX_BUDGET_USD=0.5
